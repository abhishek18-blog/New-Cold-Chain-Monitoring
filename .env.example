# Kafka Cluster Configuration
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka-1:19092,kafka-2:19094
KAFKA_BOOTSTRAP_SERVERS_EXTERNAL=localhost:9092,localhost:9094
KAFKA_TOPIC_TELEMETRY=truck-telemetry
KAFKA_TOPIC_DLQ=truck-telemetry-dlq

# Generator Configuration
PING_INTERVAL_SEC=5
EXCURSION_PROBABILITY=0.015

# Google Cloud Emulators Configuration
GCP_PROJECT_ID=coldchain-local
PUBSUB_EMULATOR_HOST=pubsub-emulator:8085
FIRESTORE_EMULATOR_HOST=firestore-emulator:8086
PUBSUB_TOPIC=telemetry-topic
PUBSUB_SUB=telemetry-sub
PUBSUB_DLQ_TOPIC=telemetry-dlq-topic
PUBSUB_ALERTS_TOPIC=alerts-topic
PUBSUB_ALERTS_SUB=alerts-sub
ALERT_COOLDOWN_SEC=300

# Archiver Configuration
ARCHIVE_FLUSH_RECORDS=1000
ARCHIVE_FLUSH_INTERVAL_SEC=30
ARCHIVE_BASE_DIR=/archive/truck-data

# Silence Detector Configuration
SILENCE_TIMEOUT_SEC=120
SILENCE_CHECK_INTERVAL_SEC=30

# Dashboard & UI Configuration
DASHBOARD_PORT=8000
KAFKA_UI_PORT=8082
