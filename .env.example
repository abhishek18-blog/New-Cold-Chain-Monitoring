# ==============================================================================
# ColdChain IoT Cloud Pipeline - Environment Configuration Template
# Pure Google Cloud Platform (Pub/Sub, Firestore, BigQuery, Cloud Run)
# ==============================================================================

# Google Cloud Project & Emulator Settings
GCP_PROJECT_ID=coldchain-local
PUBSUB_EMULATOR_HOST=pubsub-emulator:8085
FIRESTORE_EMULATOR_HOST=firestore-emulator:8086

# Pub/Sub Ingestion & Alerting Topics / Subscriptions
PUBSUB_TOPIC=telemetry-topic
PUBSUB_SUB=telemetry-sub
PUBSUB_DLQ_TOPIC=telemetry-dlq-topic
PUBSUB_ALERTS_TOPIC=alerts-topic
PUBSUB_ALERTS_SUB=alerts-sub

# Telemetry Generator Cadence & Failure Injection
PING_INTERVAL_SEC=1.0
EXCURSION_PROBABILITY=0.015

# Driver Notification Network (Discord Real-Time Webhook)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
DISCORD_VOICE_TTS=false
ALERT_COOLDOWN_SEC=300

# Silence / Signal Loss Detector
SILENCE_TIMEOUT_SEC=120
SILENCE_CHECK_INTERVAL_SEC=30

# Web Dashboard Port
DASHBOARD_PORT=8000
